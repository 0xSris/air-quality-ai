APP_ENV=development
APP_NAME=Air Quality AI
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATA_ROOT=./ml/data
RAW_DATA_DIR=./ml/data/raw/Data_SIH_2025
PROCESSED_DATA_DIR=./ml/data/processed
ARTIFACTS_DIR=./ml/artifacts
LIVE_SOURCE_MODE=auto
LIVE_EXTERNAL_PROVIDER=openmeteo
LIVE_EXTERNAL_TIMEZONE=Asia/Kolkata
LIVE_EXTERNAL_DOMAINS=cams_global
LIVE_EXTERNAL_PAST_HOURS=24
LIVE_EXTERNAL_FORECAST_HOURS=24
LIVE_EXTERNAL_TIMEOUT_SECONDS=30
LIVE_REFRESH_SECONDS=10
FORECAST_HORIZON_HOURS=24
LOOKBACK_HOURS=168
ALERT_O3_THRESHOLD=100.0
ALERT_NO2_THRESHOLD=80.0
SIMULATION_SPEED=120
DEFAULT_SITE_ID=1
MODEL_NAME=baseline_random_forest
MODEL_DEVICE=cpu
EXTERNAL_DATA_DIR=./ml/data/external
ENABLE_EXTERNAL_TRAINING_AUGMENTATION=false
APP_DB_PATH=./backend/app.db
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=all-MiniLM-L6-v2
RESEARCH_EXPORT_DIR=./backend/exports
